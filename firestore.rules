rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Keep this list in sync with PROFESSOR_EMAILS in src/config.js
    function isProfessor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'draconic788@gmail.com',
          'renzkerbysajuelaofficial@gmail.com',
          'ajosejustingabriel@gmail.com'
        ];
    }

    match /events/{eventId} {
      // Students can only add events under their own uid, with a known event type
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['JOINED', 'AWAY', 'RETURNED', 'LEFT', 'IDLE', 'LOCKED', 'ACTIVE']
        && request.resource.data.time is int;

      // Only professors can read; nobody can edit or delete events
      allow read: if isProfessor();
      allow update, delete: if false;
    }
  }
}
