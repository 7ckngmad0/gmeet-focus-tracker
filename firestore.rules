rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isProfessor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'draconic788@gmail.com',
          'renzkerbysajuelaofficial@gmail.com',
          'ajosejustingabriel@gmail.com'
        ];
    }

    function validMeetingCode(code) {
      return code is string
        && code.matches('^[a-z]{3}-[a-z]{4}-[a-z]{3}$');
    }

    function validActivityOptions(options) {
      return options is list
        && options.size() >= 2
        && options.size() <= 6
        && options[0] is string && options[0].size() > 0 && options[0].size() <= 120
        && options[1] is string && options[1].size() > 0 && options[1].size() <= 120
        && (options.size() < 3 || (options[2] is string && options[2].size() > 0 && options[2].size() <= 120))
        && (options.size() < 4 || (options[3] is string && options[3].size() > 0 && options[3].size() <= 120))
        && (options.size() < 5 || (options[4] is string && options[4].size() > 0 && options[4].size() <= 120))
        && (options.size() < 6 || (options[5] is string && options[5].size() > 0 && options[5].size() <= 120));
    }

    function validSessionTransition() {
      return request.resource.data.status == 'paused'
          && resource.data.status == 'active'
          && request.resource.data.pausedAtMs is int
        || request.resource.data.status == 'active'
          && resource.data.status == 'paused'
          && request.resource.data.startedAtMs is int
          && request.resource.data.pausedAtMs == null
        || request.resource.data.status == 'ended'
          && resource.data.status in ['active', 'paused']
          && request.resource.data.endedAt == request.time;
    }

    function validEventSession() {
      let sessionPath =
        /databases/$(database)/documents/sessions/$(request.resource.data.sessionId);
      return request.resource.data.sessionId is string
        && exists(sessionPath)
        && get(sessionPath).data.meetingCode == request.resource.data.meetingCode
        && get(sessionPath).data.status == 'active';
    }

    function validStudentEvent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.resource.data.keys().hasOnly([
          'type', 'meetingCode', 'sessionId', 'student', 'email', 'uid',
          'time', 'clientTime', 'tabCount', 'receivedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.student is string
        && request.resource.data.student.size() <= 200
        && request.resource.data.type in [
          'JOINED', 'AWAY', 'RETURNED', 'LEFT', 'IDLE', 'LOCKED',
          'ACTIVE', 'TABS_UPDATED', 'HEARTBEAT'
        ]
        && validMeetingCode(request.resource.data.meetingCode)
        && request.resource.data.time is int
        && request.resource.data.clientTime == request.resource.data.time
        && request.resource.data.time <= request.time.toMillis() + 86400000
        && request.resource.data.tabCount is int
        && request.resource.data.tabCount >= 0
        && request.resource.data.tabCount <= 1000
        && request.resource.data.receivedAt == request.time
        && validEventSession();
    }

    function validAfkAcknowledgement() {
      return isProfessor()
        && resource.data.teacherUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'acknowledged'
        && request.resource.data.acknowledgedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acknowledgedAt']);
    }

    function validStudentAfkReturn() {
      return request.auth != null
        && resource.data.studentUid == request.auth.uid
        && resource.data.status in ['pending', 'acknowledged']
        && request.resource.data.status == 'returned'
        && request.resource.data.returnedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'returnedAt']);
    }

    match /sessions/{sessionId} {
      // Students can discover only active sessions; professors can also inspect paused/ended sessions.
      allow get, list: if isProfessor()
        || (request.auth != null && resource.data.status == 'active');

      allow create: if isProfessor()
        && request.resource.data.keys().hasOnly([
          'status', 'meetingCode', 'course', 'classLabel',
          'startedAtMs', 'elapsedMs', 'startedAt', 'teacherUid'
        ])
        && request.resource.data.status == 'active'
        && validMeetingCode(request.resource.data.meetingCode)
        && request.resource.data.course is string
        && request.resource.data.course.size() <= 120
        && request.resource.data.classLabel is string
        && request.resource.data.classLabel.size() <= 120
        && request.resource.data.startedAtMs is int
        && request.resource.data.elapsedMs == 0
        && request.resource.data.startedAt == request.time
        && request.resource.data.teacherUid == request.auth.uid;

      allow update: if isProfessor()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'elapsedMs', 'pausedAtMs', 'startedAtMs',
          'updatedAt', 'endedAt'
        ])
        && request.resource.data.elapsedMs is int
        && request.resource.data.elapsedMs >= 0
        && request.resource.data.elapsedMs >= resource.data.elapsedMs
        && request.resource.data.updatedAt == request.time
        && validSessionTransition();

      allow delete: if false;
    }

    match /events/{eventId} {
      allow create: if validStudentEvent();

      // Retrying the same event may refresh only its trusted server timestamp.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['receivedAt'])
        && validStudentEvent();

      allow read: if isProfessor();
      allow delete: if false;
    }

    match /afkRequests/{requestId} {
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'sessionId', 'teacherUid', 'studentUid', 'studentEmail',
          'studentName', 'reason', 'status', 'createdAt'
        ])
        && request.resource.data.sessionId is string
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'active'
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.teacherUid == request.resource.data.teacherUid
        && request.resource.data.teacherUid is string
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.studentEmail == request.auth.token.email.lower()
        && request.resource.data.studentName is string
        && request.resource.data.studentName.size() <= 120
        && request.resource.data.reason in ['Short break', 'Urgent matter', 'Other']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow read: if (isProfessor() && resource.data.teacherUid == request.auth.uid)
        || (request.auth != null && resource.data.studentUid == request.auth.uid);

      allow update: if validAfkAcknowledgement() || validStudentAfkReturn();

      allow delete: if false;
    }

    match /professorAlerts/{alertId} {
      allow create: if isProfessor()
        && request.resource.data.keys().hasOnly([
          'sessionId', 'teacherUid', 'targetUids', 'message', 'createdAt'
        ])
        && request.resource.data.sessionId is string
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'active'
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.teacherUid == request.auth.uid
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.targetUids is list
        && request.resource.data.targetUids.size() > 0
        && request.resource.data.targetUids.size() <= 100
        && request.resource.data.message == 'Your professor noticed your Meet tab is hidden. Please return to the class when you are ready.'
        && request.resource.data.createdAt == request.time;

      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid in resource.data.targetUids;

      allow update, delete: if false;
    }

    match /classActivities/{activityId} {
      allow create: if isProfessor()
        && request.resource.data.keys().hasOnly([
          'sessionId', 'teacherUid', 'meetingCode', 'word', 'question', 'responseType',
          'options', 'correctAnswer', 'targetUids', 'targetStudents',
          'durationSeconds', 'startedAtMs', 'expiresAtMs', 'status', 'createdAt'
        ])
        && request.resource.data.sessionId is string
        && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'active'
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.teacherUid == request.auth.uid
        && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.meetingCode == request.resource.data.meetingCode
        && request.resource.data.teacherUid == request.auth.uid
        && validMeetingCode(request.resource.data.meetingCode)
        && (
          (request.resource.data.question is string
            && request.resource.data.question.size() > 0
            && request.resource.data.question.size() <= 240
            && request.resource.data.responseType in ['short-answer', 'multiple-choice']
            && request.resource.data.correctAnswer is string
            && request.resource.data.correctAnswer.size() <= 120
            && (request.resource.data.correctAnswer == ''
              || request.resource.data.responseType == 'short-answer'
              || request.resource.data.correctAnswer in request.resource.data.options)
            && ((request.resource.data.responseType == 'short-answer'
                && request.resource.data.options is list
                && request.resource.data.options.size() == 0)
              || (request.resource.data.responseType == 'multiple-choice'
                && validActivityOptions(request.resource.data.options))))
          || (request.resource.data.word is string
            && request.resource.data.word.size() > 0
            && request.resource.data.word.size() <= 120)
        )
        && request.resource.data.targetUids is list
        && request.resource.data.targetUids.size() > 0
        && request.resource.data.targetUids.size() <= 300
        && request.resource.data.targetStudents is list
        && request.resource.data.targetStudents.size() == request.resource.data.targetUids.size()
        && request.resource.data.durationSeconds in [30, 60, 120, 300]
        && request.resource.data.startedAtMs is int
        && request.resource.data.expiresAtMs is int
        && request.resource.data.expiresAtMs > request.time.toMillis()
        && request.resource.data.expiresAtMs <= request.time.toMillis() + 310000
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time;

      allow read: if (isProfessor() && resource.data.teacherUid == request.auth.uid)
        || (request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid in resource.data.targetUids
          && exists(/databases/$(database)/documents/sessions/$(resource.data.sessionId))
          && get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status in ['active', 'paused']);

      allow update: if isProfessor()
        && resource.data.teacherUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'closed'
        && resource.data.status == 'active';

      allow delete: if false;

      match /responses/{studentUid} {
        function activity() {
          return get(/databases/$(database)/documents/classActivities/$(activityId));
        }

        allow create: if request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid == studentUid
          && request.resource.data.keys().hasOnly([
            'uid', 'email', 'name', 'answer', 'answeredAt'
          ])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email.lower() == request.auth.token.email.lower()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 120
          && request.resource.data.answer is string
          && request.resource.data.answer.size() > 0
          && request.resource.data.answer.size() <= 120
          && request.resource.data.answeredAt == request.time
          && activity().data.status == 'active'
          && activity().data.expiresAtMs > request.time.toMillis()
          && request.auth.uid in activity().data.targetUids
          && (!('responseType' in activity().data)
            || activity().data.responseType != 'multiple-choice'
            || request.resource.data.answer in activity().data.options)
          && activity().data.sessionId is string
          && get(/databases/$(database)/documents/sessions/$(activity().data.sessionId)).data.status == 'active';

        allow read: if (isProfessor()
            && activity().data.teacherUid == request.auth.uid)
          || (request.auth != null && request.auth.uid == studentUid);

        allow update, delete: if false;
      }
    }
  }
}
